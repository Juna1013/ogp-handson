---
interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<html lang="ja">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <meta name="description" content="{description}" />
    </head>
    <body>
        <slot />
    </body>
</html>